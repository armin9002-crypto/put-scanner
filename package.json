{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:report": "node scripts/build-report.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "responsive:check": "node scripts/responsive-checklist.mjs",
    "sync:payload-report": "node scripts/stage5-payload-report.mjs",
    "sync:enrollment-hardening-check": "node --test tests/supabase-stage5c3-enrollment-hardening.test.mjs",
    "sync:production-check": "node --test tests/supabase-stage5c-production-sync.test.mjs",
    "sync:rollout-mobile-check": "node --test tests/supabase-stage5d1-mobile-account.test.mjs",
    "sync:conflict-recovery-check": "node --test tests/supabase-stage5e-conflict-recovery.test.mjs tests/supabase-stage5e-conflict-ui.test.mjs",
    "sync:resume-check": "node --test tests/supabase-stage5b1-resume.test.mjs",
    "sync:test-harness-check": "node --test tests/supabase-stage5b-live-sync-harness.test.mjs",
    "selfcheck": "node scripts/selfcheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "visual:ui1": "node scripts/ui-overhaul-screenshots.mjs",
    "visual:ui2": "node scripts/ui-overhaul-ui2-screenshots.mjs",
    "visual:ui3": "node scripts/ui-overhaul-ui3-screenshots.mjs",
    "visual:ui4": "node scripts/ui-overhaul-ui4-screenshots.mjs",
    "visual:ui5": "node scripts/ui-overhaul-ui5-screenshots.mjs",
    "verify": "npm run typecheck && npm test && npm run selfcheck && npm run responsive:check && npm run build && npm run lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "tesseract.js": "^7.0.0",
    "yahoo-finance2": "^4.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
